# ============================================================================
# Enterprise Deal Commander — API server environment
# ============================================================================
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is git-ignored and must never be committed.

# PostgreSQL connection string (required).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The app uses the `edc` and `edc_v2` schemas inside this database.
DATABASE_URL=postgres://edc:edc@localhost:5432/edc

# Secret used to sign session JWTs (required in production).
# Generate a long random value, e.g.:  openssl rand -hex 32
# In development a fallback constant is used if this is unset, but you should
# always set it explicitly.
SESSION_SECRET=change-me-to-a-long-random-string

# Node environment: "development" | "production".
# In production, session cookies are marked Secure and SESSION_SECRET is required.
NODE_ENV=development

# Port the API server listens on (defaults to 5000 if unset).
PORT=5000

# Full public origin (scheme + host) users hit in their browser — used to
# build absolute Bat-Signal share links (POST /deals/:id/bat-signal). This is
# NOT the API server's own port: in local dev the frontend runs on :5173 and
# proxies /api to this server on :5000, so the origin users share links from
# is :5173. Leave unset and Bat-Signal falls back to a relative /share/:token
# path, which is not a usable link when copied out of the app.
#   Local dev:   APP_ORIGIN=http://localhost:5173
#   Production:  APP_ORIGIN=https://your-domain.example.com
# TODO(catalyst): revisit once this app is served from Zoho Catalyst — a
# custom domain and/or a URL sub-path may need to be accounted for here.
APP_ORIGIN=http://localhost:5173
