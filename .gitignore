# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# AppSail deploy zips (built on demand by build-appsail.ts, uploaded by hand
# via the Catalyst Console — never committed). Both locations: the zip is
# assembled next to dist/, and a copy is staged at the repo root or in
# .playwright-mcp/ when uploading through a browser-driven Console session.
artifacts/api-server/*.zip
*.zip
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local tooling / caches
.cache/
.local/

# subagent-driven-development scratch
.superpowers/

# git worktrees (superpowers:using-git-worktrees)
.worktrees/

# git worktrees (native harness EnterWorktree tool)
.claude/worktrees/

# Secrets and local env
.env
.env.*
# ...but DO track the example templates (they contain no secrets)
!.env.example
!**/.env.example

# Catalyst AppSail startup config — carries a real (if placeholder-strength)
# SESSION_SECRET and an absolute local build_path; not meant to be shared.
# The Console deploy ignores its env_variables anyway (real values live in
# Console > Configuration, per environment) — this file is local convenience
# + documentation. Track app-config.example.json instead.
artifacts/api-server/app-config.json

# Playwright MCP scratch artifacts
.playwright-mcp/

# Claude Code local-only settings (personal permissions, not shared)
.claude/settings.local.json
